# -----------------------------------------------------------------------------
# SpeedyGo Backend — environment template
# Copy to .env for local development. Do NOT put real secrets in this file.
# -----------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000

# API
API_GLOBAL_PREFIX=api/v1

# -----------------------------------------------------------------------------
# PostgreSQL (docker compose service: postgres — host port 5433 → container 5432)
# Override host publish with SPEEDYGO_POSTGRES_HOST_PORT if needed.
# Inside Compose networks use postgres:5432.
# E2E ignores this URL and uses 127.0.0.1:5433/speedygo_test (see test/setup-e2e-env.ts).
# Never point production/staging at speedygo_test.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://speedygo:speedygo@localhost:5433/speedygo_dev?schema=public
SPEEDYGO_POSTGRES_HOST_PORT=5433

# -----------------------------------------------------------------------------
# Redis (docker compose service: redis — host port 6381 → container 6379)
# Override host publish with SPEEDYGO_REDIS_HOST_PORT if needed.
# Inside Compose networks use redis:6379. Never use DB15 for production/staging.
# E2E ignores this URL and uses redis://127.0.0.1:6381/15 (see test/setup-e2e-env.ts).
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6381
SPEEDYGO_REDIS_HOST_PORT=6381

# -----------------------------------------------------------------------------
# Auth (placeholders only — replace locally, never commit real values)
# Production refuses empty/placeholder secrets and OTP_TRANSPORT=console|test.
# Refresh tokens are opaque (not JWT). JWT_REFRESH_SECRET is unused.
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace_with_local_access_secret
JWT_ACCESS_TTL_SECONDS=900
AUTH_SESSION_TTL_DAYS=30
OTP_HMAC_SECRET=replace_with_local_otp_hmac_secret
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_HOUR=5
OTP_MAX_REQUESTS_PER_IP_PER_HOUR=20
AUTH_DEFAULT_COUNTRY=DZ
OTP_TRANSPORT=disabled
AUTH_TRUST_PROXY=false
AUTH_REDIS_PREFIX=auth:

# -----------------------------------------------------------------------------
# Driver Matching v1.0 (frozen defaults)
# -----------------------------------------------------------------------------
# Offer lifetime. Driver expiresAt is assignedAt + this value. BullMQ timeout delay.
MATCHING_OFFER_TIMEOUT_MS=30000
# Location older than this is not geo-matchable and cannot be accepted. Does not rewrite availability.
MATCHING_LOCATION_MAX_AGE_MS=45000
# Candidate must be within this distance of live MerchantBranch pickup (not Customer dropoff).
MATCHING_PICKUP_RADIUS_METERS=5000
# Redis GEO COUNT bound. Matching never scans all Drivers.
MATCHING_CANDIDATE_LIMIT=20
# Delay before another matching attempt when no eligible Driver exists. Delivery stays SEARCHING_DRIVER.
MATCHING_RETRY_DELAY_MS=15000
# Periodic recovery for READY orders missing matching jobs (READY-commit / enqueue gap).
MATCHING_RECOVERY_INTERVAL_MS=15000
# Max orders/deliveries inspected per recovery pass.
MATCHING_RECOVERY_BATCH_SIZE=50
# Redis GEO + per-Driver freshness hash prefix. Isolated in e2e as matching:test:
MATCHING_REDIS_PREFIX=matching:
# BullMQ key prefix. Isolated in e2e as bull:matching:test
MATCHING_BULL_PREFIX=bull:matching

# -----------------------------------------------------------------------------
# Notifications Foundation v1.0 (IN_APP recovery)
# -----------------------------------------------------------------------------
# Periodic bounded repair for business-commit → IN_APP Notification gaps.
NOTIFICATIONS_RECOVERY_INTERVAL_MS=30000
# Max candidates inspected per source type per recovery pass.
NOTIFICATIONS_RECOVERY_BATCH_SIZE=50
# Only repair sources newer than this lookback (not historical backfill).
NOTIFICATIONS_RECOVERY_LOOKBACK_MS=86400000

# -----------------------------------------------------------------------------
# Driver Delivery Workflow v1.0
# -----------------------------------------------------------------------------
# Inclusive arrival radius to live MerchantBranch pickup. Freshness reuses MATCHING_LOCATION_MAX_AGE_MS.
DRIVER_DELIVERY_PICKUP_RADIUS_METERS=300
# Inclusive arrival radius to OrderDeliveryAddressSnapshot dropoff. Freshness reuses MATCHING_LOCATION_MAX_AGE_MS.
DRIVER_DELIVERY_DROPOFF_RADIUS_METERS=300

# -----------------------------------------------------------------------------
# Realtime Tracking Foundation v1.0
# -----------------------------------------------------------------------------
# Per-Driver location hash TTL (10 minutes). Must be > cleanup grace and >= 45s freshness.
TRACKING_LOCATION_TTL_MS=600000
# GEO member cleanup interval. Correctness does not depend on this timing.
TRACKING_STALE_CLEANUP_INTERVAL_MS=30000
# Remove GEO members whose hash is missing or older than this grace window (5 minutes).
TRACKING_STALE_CLEANUP_MAX_AGE_MS=300000
TRACKING_STALE_CLEANUP_BATCH_SIZE=100
# Minimum accepted Driver location publish interval (per Driver identity, all transports).
TRACKING_MIN_UPDATE_INTERVAL_MS=1000
# Periodic socket authorization/session revalidation (15 seconds).
TRACKING_AUTH_REVALIDATION_INTERVAL_MS=15000
# Redis prefix for tracking rate-limit keys. Isolated in e2e as tracking:test:
TRACKING_REDIS_PREFIX=tracking:
# Socket.IO Redis adapter key prefix. Isolated in e2e as socket.io:tracking:test
TRACKING_SOCKET_ADAPTER_PREFIX=socket.io:tracking

# -----------------------------------------------------------------------------
# Private verification document storage (Driver/Merchant evidence only)
# -----------------------------------------------------------------------------
# local = private disk root for development (never use in production).
# s3 = S3-compatible private bucket (AWS / R2 / MinIO).
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=/tmp/speedygo-private-storage
STORAGE_UPLOADS_ENABLED=true
STORAGE_REDIS_PREFIX=storage:
STORAGE_PENDING_UPLOAD_TTL_SECONDS=3600
STORAGE_MALWARE_SCAN_REQUIRED=false
STORAGE_MALWARE_SCANNER_DRIVER=unavailable
STORAGE_CLAMAV_HOST=127.0.0.1
STORAGE_CLAMAV_PORT=3311
STORAGE_CLAMAV_CONNECT_TIMEOUT_MS=3000
STORAGE_CLAMAV_SCAN_TIMEOUT_MS=30000
STORAGE_PENDING_CLEANUP_INTERVAL_MS=60000
STORAGE_PENDING_CLEANUP_BATCH_SIZE=50
# When true, uploads fail closed if malware scanning is unavailable.
# Production with uploads enabled requires STORAGE_MALWARE_SCAN_REQUIRED=true and DRIVER=clamav.
# S3-compatible (preferred names). Legacy S3_* aliases still accepted.
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=speedygo-dev
STORAGE_S3_ACCESS_KEY_ID=speedygo
STORAGE_S3_SECRET_ACCESS_KEY=speedygo_dev_password
STORAGE_S3_FORCE_PATH_STYLE=true
# Legacy aliases (optional):
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=speedygo-dev
S3_ACCESS_KEY_ID=speedygo
S3_SECRET_ACCESS_KEY=speedygo_dev_password

# -----------------------------------------------------------------------------
# Future integrations — leave empty until credentials are issued
# -----------------------------------------------------------------------------
FCM_PROJECT_ID=

GOOGLE_MAPS_API_KEY=

# Production electronic provider is Chargily Pay V2. Use chargily in production.
# Non-production may use test (in-process adapter) or chargily (Chargily test/live API).
PAYMENT_PROVIDER=chargily
CHARGILY_SECRET_KEY=
# test = https://pay.chargily.net/test/api/v2 ; live = https://pay.chargily.net/api/v2
# NODE_ENV=production requires live.
CHARGILY_MODE=test
PAYMENT_RETURN_URL=
PAYMENT_CANCEL_URL=
PAYMENT_WEBHOOK_URL=
# Test/dev adapter only. Forbidden when NODE_ENV=production.
PAYMENT_TEST_WEBHOOK_SECRET=
