# -----------------------------------------------------------------------------
# SpeedyGo Backend — environment template
# Copy to .env for local development. Do NOT put real secrets in this file.
# -----------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000

# API
API_GLOBAL_PREFIX=api/v1

# -----------------------------------------------------------------------------
# PostgreSQL (docker compose service: postgres — host port 5432)
# Prisma 8 requires PostgreSQL >= 15.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://speedygo:speedygo@localhost:5432/speedygo_dev?schema=public

# -----------------------------------------------------------------------------
# Redis (docker compose service: redis — host port 6379)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Auth (placeholders only — replace locally, never commit real values)
# Production refuses empty/placeholder secrets and OTP_TRANSPORT=console|test.
# Refresh tokens are opaque (not JWT). JWT_REFRESH_SECRET is unused.
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace_with_local_access_secret
JWT_ACCESS_TTL_SECONDS=900
AUTH_SESSION_TTL_DAYS=30
OTP_HMAC_SECRET=replace_with_local_otp_hmac_secret
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_HOUR=5
OTP_MAX_REQUESTS_PER_IP_PER_HOUR=20
AUTH_DEFAULT_COUNTRY=DZ
OTP_TRANSPORT=disabled
AUTH_TRUST_PROXY=false
AUTH_REDIS_PREFIX=auth:

# -----------------------------------------------------------------------------
# Driver Matching v1.0 (frozen defaults)
# -----------------------------------------------------------------------------
# Offer lifetime. Driver expiresAt is assignedAt + this value. BullMQ timeout delay.
MATCHING_OFFER_TIMEOUT_MS=30000
# Location older than this is not geo-matchable and cannot be accepted. Does not rewrite availability.
MATCHING_LOCATION_MAX_AGE_MS=45000
# Candidate must be within this distance of live MerchantBranch pickup (not Customer dropoff).
MATCHING_PICKUP_RADIUS_METERS=5000
# Redis GEO COUNT bound. Matching never scans all Drivers.
MATCHING_CANDIDATE_LIMIT=20
# Delay before another matching attempt when no eligible Driver exists. Delivery stays SEARCHING_DRIVER.
MATCHING_RETRY_DELAY_MS=15000
# Periodic recovery for READY orders missing matching jobs (READY-commit / enqueue gap).
MATCHING_RECOVERY_INTERVAL_MS=15000
# Max orders/deliveries inspected per recovery pass.
MATCHING_RECOVERY_BATCH_SIZE=50
# Redis GEO + per-Driver freshness hash prefix. Isolated in e2e as matching:test:
MATCHING_REDIS_PREFIX=matching:
# BullMQ key prefix. Isolated in e2e as bull:matching:test
MATCHING_BULL_PREFIX=bull:matching

# -----------------------------------------------------------------------------
# Driver Delivery Workflow v1.0
# -----------------------------------------------------------------------------
# Inclusive arrival radius to live MerchantBranch pickup. Freshness reuses MATCHING_LOCATION_MAX_AGE_MS.
DRIVER_DELIVERY_PICKUP_RADIUS_METERS=300
# Inclusive arrival radius to OrderDeliveryAddressSnapshot dropoff. Freshness reuses MATCHING_LOCATION_MAX_AGE_MS.
DRIVER_DELIVERY_DROPOFF_RADIUS_METERS=300

# -----------------------------------------------------------------------------
# Realtime Tracking Foundation v1.0
# -----------------------------------------------------------------------------
# Per-Driver location hash TTL (10 minutes). Must be > cleanup grace and >= 45s freshness.
TRACKING_LOCATION_TTL_MS=600000
# GEO member cleanup interval. Correctness does not depend on this timing.
TRACKING_STALE_CLEANUP_INTERVAL_MS=30000
# Remove GEO members whose hash is missing or older than this grace window (5 minutes).
TRACKING_STALE_CLEANUP_MAX_AGE_MS=300000
TRACKING_STALE_CLEANUP_BATCH_SIZE=100
# Minimum accepted Driver location publish interval (per Driver identity, all transports).
TRACKING_MIN_UPDATE_INTERVAL_MS=1000
# Periodic socket authorization/session revalidation (15 seconds).
TRACKING_AUTH_REVALIDATION_INTERVAL_MS=15000
# Redis prefix for tracking rate-limit keys. Isolated in e2e as tracking:test:
TRACKING_REDIS_PREFIX=tracking:
# Socket.IO Redis adapter key prefix. Isolated in e2e as socket.io:tracking:test
TRACKING_SOCKET_ADAPTER_PREFIX=socket.io:tracking

# -----------------------------------------------------------------------------
# Object storage / S3-compatible (docker compose MinIO — API 9000, console 9001)
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=speedygo-dev
S3_ACCESS_KEY_ID=speedygo
S3_SECRET_ACCESS_KEY=speedygo_dev_password

# -----------------------------------------------------------------------------
# Future integrations — leave empty until credentials are issued
# -----------------------------------------------------------------------------
FCM_PROJECT_ID=

GOOGLE_MAPS_API_KEY=

PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
