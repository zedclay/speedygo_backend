# -----------------------------------------------------------------------------
# SpeedyGo Backend — environment template
# Copy to .env for local development. Do NOT put real secrets in this file.
# -----------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000

# API
API_GLOBAL_PREFIX=api/v1

# -----------------------------------------------------------------------------
# PostgreSQL (docker compose service: postgres — host port 5432)
# Prisma 8 requires PostgreSQL >= 15.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://speedygo:speedygo@localhost:5432/speedygo_dev?schema=public

# -----------------------------------------------------------------------------
# Redis (docker compose service: redis — host port 6379)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Auth tokens (placeholders only — replace locally, never commit real values)
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace_with_local_access_secret
JWT_REFRESH_SECRET=replace_with_local_refresh_secret

# -----------------------------------------------------------------------------
# Object storage / S3-compatible (docker compose MinIO — API 9000, console 9001)
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=speedygo-dev
S3_ACCESS_KEY_ID=speedygo
S3_SECRET_ACCESS_KEY=speedygo_dev_password

# -----------------------------------------------------------------------------
# Future integrations — leave empty until credentials are issued
# -----------------------------------------------------------------------------
FCM_PROJECT_ID=

GOOGLE_MAPS_API_KEY=

PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
