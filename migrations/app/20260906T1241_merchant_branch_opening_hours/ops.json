      {
        "description": "create table \"merchant_branch_opening_intervals\"",
        "sql": "CREATE TABLE \"public\".\"merchant_branch_opening_intervals\" (\n  \"closes_minute\" int4 NOT NULL,\n  \"closes_next_day\" bool NOT NULL,\n  \"created_at\" timestamptz(6) DEFAULT (now()) NOT NULL,\n  \"day_of_week\" int4 NOT NULL,\n  \"id\" uuid NOT NULL,\n  \"opens_minute\" int4 NOT NULL,\n  \"schedule_id\" uuid NOT NULL,\n  \"sort_order\" int4 NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"mboi_closes_minute_range_bf3125d6\" CHECK (closes_minute >= 0 AND closes_minute <= 1439),\n  CONSTRAINT \"mboi_day_of_week_range_90497d90\" CHECK (day_of_week >= 1 AND day_of_week <= 7),\n  CONSTRAINT \"mboi_interval_duration_3dca9e58\" CHECK ((closes_next_day = false AND closes_minute > opens_minute) OR (closes_next_day = true AND ((1440 - opens_minute) + closes_minute) > 0 AND ((1440 - opens_minute) + closes_minute) <= 1440)),\n  CONSTRAINT \"mboi_opens_minute_range_c4a5e691\" CHECK (opens_minute >= 0 AND opens_minute <= 1439),\n  CONSTRAINT \"mboi_sort_order_nonneg_eb4b5508\" CHECK (sort_order >= 0)\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"merchant_branch_opening_intervals\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
        "params": [
          "\"public\".\"merchant_branch_opening_intervals\""
        ]
      }
    ]
