        "sql": "CREATE TABLE \"public\".\"order_preparation_estimate_revisions\" (\n  \"actor_account_id\" uuid NOT NULL,\n  \"add_minutes\" int4 NOT NULL,\n  \"created_at\" timestamptz(6) DEFAULT (now()) NOT NULL,\n  \"id\" uuid NOT NULL,\n  \"new_estimated_ready_at\" timestamptz(6) NOT NULL,\n  \"order_id\" uuid NOT NULL,\n  \"previous_estimated_ready_at\" timestamptz(6),\n  \"reason\" character varying(255),\n  \"revision_number\" int4 NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"order_prep_estimate_revisions_add_positive_bb75bf37\" CHECK (add_minutes > 0),\n  CONSTRAINT \"order_prep_estimate_revisions_rev_positive_fe94db1c\" CHECK (revision_number > 0)\n)",
