        "sql": "CREATE TABLE \"public\".\"merchant_member_invitations\" (\n  \"accepted_at\" timestamptz(6),\n  \"accepted_by_account_id\" uuid,\n  \"cancelled_at\" timestamptz(6),\n  \"created_at\" timestamptz(6) DEFAULT (now()) NOT NULL,\n  \"created_by_account_id\" uuid NOT NULL,\n  \"expires_at\" timestamptz(6) NOT NULL,\n  \"id\" uuid NOT NULL,\n  \"merchant_id\" uuid NOT NULL,\n  \"phone\" character varying(32) NOT NULL,\n  \"role\" character varying(64) NOT NULL,\n  \"status\" character varying(64) NOT NULL,\n  \"token_hash\" character varying(128) NOT NULL,\n  \"updated_at\" timestamptz(6) DEFAULT (now()) NOT NULL,\n  \"version\" int4 DEFAULT 1 NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"mmi_role_values_75886224\" CHECK (role IN ('MANAGER', 'STAFF')),\n  CONSTRAINT \"mmi_status_values_3b81a0af\" CHECK (status IN ('PENDING', 'ACCEPTED', 'CANCELLED', 'EXPIRED')),\n  CONSTRAINT \"mmi_version_positive_c2490804\" CHECK (version >= 1)\n)",
        "params": []
      }
