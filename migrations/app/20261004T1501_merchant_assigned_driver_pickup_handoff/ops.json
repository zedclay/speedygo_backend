        "description": "create table \"delivery_pickup_handoffs\"",
        "sql": "CREATE TABLE \"public\".\"delivery_pickup_handoffs\" (\n  \"assignment_id\" uuid NOT NULL,\n  \"assignment_version\" int4 NOT NULL,\n  \"attempt_count\" int4 DEFAULT 0 NOT NULL,\n  \"code_hash\" character varying(128) NOT NULL,\n  \"code_sealed\" text NOT NULL,\n  \"consumed_at\" timestamptz(6),\n  \"consumed_by_driver_id\" uuid,\n  \"created_at\" timestamptz(6) DEFAULT (now()) NOT NULL,\n  \"created_by_account_id\" uuid,\n  \"delivery_id\" uuid NOT NULL,\n  \"expires_at\" timestamptz(6) NOT NULL,\n  \"id\" uuid NOT NULL,\n  \"invalidated_at\" timestamptz(6),\n  \"invalidated_reason\" character varying(64),\n  \"locked_until\" timestamptz(6),\n  \"max_attempts\" int4 DEFAULT 5 NOT NULL,\n  \"status\" character varying(64) NOT NULL,\n  \"updated_at\" timestamptz(6) DEFAULT (now()) NOT NULL,\n  \"version\" int4 DEFAULT 1 NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"dph_assignment_version_positive_e4eba578\" CHECK (assignment_version >= 1),\n  CONSTRAINT \"dph_attempt_count_nonneg_0b6f9474\" CHECK (attempt_count >= 0),\n  CONSTRAINT \"dph_max_attempts_positive_8cc96d9d\" CHECK (max_attempts >= 1),\n  CONSTRAINT \"dph_status_values_303afc9b\" CHECK (status IN ('PENDING', 'CONSUMED', 'INVALIDATED', 'EXPIRED', 'LOCKED')),\n  CONSTRAINT \"dph_version_positive_c2490804\" CHECK (version >= 1)\n)",
        "params": []
